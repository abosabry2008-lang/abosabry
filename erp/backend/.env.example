# Copy this file to ".env" and adjust the values.

# ---------------------------------------------------------------------------
# PostgreSQL connection string
#
# Local development (the portable cluster in %LOCALAPPDATA%\erp-tools):
#   DATABASE_URL="postgresql://erp:erp@localhost:5432/erp?schema=public"
#
# Production (Neon / Render Postgres / any managed Postgres) — needs SSL:
#   DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://erp:erp@localhost:5432/erp?schema=public"

# Secrets for signing tokens -- CHANGE THESE IN PRODUCTION
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Server (Render sets PORT automatically for web services)
PORT=4000
NODE_ENV="development"

# Comma separated list of allowed browser origins, or "*" for any.
# In production set the exact front-end URL, e.g.
#   CORS_ORIGIN="https://erp-web.onrender.com"
CORS_ORIGIN="*"

# Password hashing cost
BCRYPT_ROUNDS=10
